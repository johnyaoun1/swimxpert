# Copy this file to .env and fill in the values.
# NEVER commit .env to git.

# ─── ASP.NET Core / Railway ─────────────────────────────────────────────────
# Production must be Production (blocks the well-known JWT_KEY).
ASPNETCORE_ENVIRONMENT=Production
# Railway injects PORT; bind all interfaces so the proxy can reach the API.
ASPNETCORE_URLS=http://0.0.0.0:${PORT}

# ─── Database (Railway Postgres or local) ───────────────────────────────────
# Railway injects DATABASE_URL as a URI, e.g.:
#   postgres://user:password@host:port/database
#   postgresql://user:password@host:port/railway?sslmode=require
# The API converts that URI to an Npgsql connection string automatically.
# For local docker-compose Postgres you can omit DATABASE_URL and use
# ConnectionStrings:DefaultConnection in appsettings, or set either format:
#   DATABASE_URL=postgres://postgres:postgres@localhost:5433/swimxpert_db
#   DATABASE_URL=Host=localhost;Port=5433;Database=swimxpert_db;Username=postgres;Password=postgres
DATABASE_URL=postgres://user:password@host:port/railway?sslmode=require

# ─── JWT ────────────────────────────────────────────────────────────────────
# Must be at least 32 random characters. Generate one with:
#   openssl rand -base64 48
JWT_KEY=your-production-secret-key-min-32-chars
JWT_ISSUER=SwimXpert.Api
JWT_AUDIENCE=SwimXpert.Client
JWT_EXPIRY_MINUTES=60

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash).
# Same-origin deploy: set to your public site (proxy serves / and /api).
CORS_ALLOWED_ORIGINS=https://swimxpert.com,https://www.swimxpert.com

# ─── Auth cookies (same-origin reverse proxy — recommended) ─────────────────
# Leave unset for SameSite=Strict + Secure off-localhost.
# AUTH_COOKIE_SAMESITE=Strict
# AUTH_COOKIE_SECURE=true
# Only for true cross-site SPA↔API (not recommended for this app):
# AUTH_COOKIE_SAMESITE=None

# ─── Public site URL (email links) ──────────────────────────────────────────
FRONTEND_URL=https://swimxpert.com

# ─── Host filtering ─────────────────────────────────────────────────────────
# Set to your production domain to prevent host-header injection attacks.
# Example: swimxpert.com  or  swimxpert.com,www.swimxpert.com
ALLOWED_HOSTS=swimxpert.com,www.swimxpert.com

# Google Calendar OAuth (same public origin as the site when using /api proxy):
# GoogleCalendar__PublicApiBaseUrl=https://swimxpert.com
# GoogleCalendar__FrontendRedirectBaseUrl=https://swimxpert.com

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
# If SMTP_HOST or SMTP_FROM is unset, sends are skipped (logged warning).
# SMTP_HOST=smtp.yourmailprovider.com
# SMTP_PORT=587
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@yourdomain.com

# ─── First admin account (runs only once on first startup) ──────────────────
# INITIAL_ADMIN_EMAIL=admin@yourdomain.com
# INITIAL_ADMIN_PASSWORD=change-me-immediately

# ─── File uploads (Cloudinary — required for persistent storage on Railway) ──
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# ─── Unused ─────────────────────────────────────────────────────────────────
# GEMINI_API_KEY — not used. AI chat was removed; Level Finder is rules-based.
