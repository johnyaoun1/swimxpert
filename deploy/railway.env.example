# Railway environment variables (split deploy: Cloudflare FE + Railway API)
# Do not commit real secrets. Set these in the Railway dashboard or via `railway variables`.

## Service: Postgres (plugin)
# Railway injects DATABASE_URL when referenced from api as ${{Postgres.DATABASE_URL}}.

## Service: api
ASPNETCORE_ENVIRONMENT=Production
DATABASE_URL=${{Postgres.DATABASE_URL}}
JWT_KEY=<openssl rand -base64 48>
JWT_ISSUER=SwimXpert.Api
JWT_AUDIENCE=SwimXpert.Client
AUTH_COOKIE_DOMAIN=.swimxpert.com
AUTH_COOKIE_SECURE=true
# Exact frontend origins (no wildcard) — required with AllowCredentials():
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://app.swimxpert.com,https://swimxpert.com,https://www.swimxpert.com
FRONTEND_URL=https://app.swimxpert.com
ALLOWED_HOSTS=*
# After api.swimxpert.com DNS is live, prefer:
# ALLOWED_HOSTS=api.swimxpert.com;api-production-3b21e.up.railway.app
RAILWAY_DOCKERFILE_PATH=SwimXpert.Api/Dockerfile
# Base64 PFX plus its password. Wraps the Data Protection key ring.
# If missing or invalid, the API still starts and Google Calendar sync stays off.
# DATA_PROTECTION_CERT=
# DATA_PROTECTION_CERT_PASSWORD=
# Optional:
# SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASS= SMTP_FROM=
# CLOUDINARY_CLOUD_NAME= CLOUDINARY_API_KEY= CLOUDINARY_API_SECRET=
# INITIAL_ADMIN_EMAIL= INITIAL_ADMIN_PASSWORD=

## Frontend (Cloudflare — not a Railway service)
# environment.prod.ts apiUrl → https://api.swimxpert.com/api (or interim Railway URL)
